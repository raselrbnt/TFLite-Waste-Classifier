<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg_light"
    android:padding="16dp">

    <!-- Header Centered Title -->
    <TextView
        android:id="@+id/tv_learn_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CATATAN &amp; PELAJARI"
        android:textColor="@color/brand_primary"
        android:fontFamily="@font/space_grotesk_bold"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Segmented Control (Toggle Tab) -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_minimal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_learn_header">

        <!-- Tab Catatan (Riwayat Scan) -->
        <TextView
            android:id="@+id/tab_catatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CATATAN"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="12sp"
            android:textColor="@color/brand_text_secondary"
            android:background="@color/brand_surface_white"
            android:clickable="true"
            android:focusable="true" />

        <!-- Tab Basis Data (Edukatif) -->
        <TextView
            android:id="@+id/tab_basis_data"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="BASIS DATA"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="12sp"
            android:textColor="@color/brand_dark_charcoal"
            android:background="@color/brand_neon"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Subtitle Panduan -->
    <TextView
        android:id="@+id/tv_learn_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panduan pemilahan offline berpresisi tinggi. Ketuk kategori untuk melihat detail."
        android:textColor="@color/brand_text_secondary"
        android:fontFamily="@font/dm_sans_regular"
        android:textSize="12sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs" />

    <!-- List Dynamic Container (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_learn_subtitle"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty State Layout -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_learn_subtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/brand_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum Ada Catatan"
            android:textColor="@color/brand_dark_charcoal"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pindai sampah Anda terlebih dahulu untuk menyimpannya di sini."
            android:textColor="@color/brand_text_secondary"
            android:fontFamily="@font/dm_sans_regular"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
