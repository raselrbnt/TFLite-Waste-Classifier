<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_minimal"
    android:padding="12dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_history_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/space_grotesk_bold"
        android:text="ORGANIK"
        android:textColor="@color/brand_dark_charcoal"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/card_image"
        app:layout_constraintTop_toTopOf="@id/card_image" />

    <TextView
        android:id="@+id/tv_history_confidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dm_sans_regular"
        android:text="98.4% Confidence"
        android:textColor="@color/brand_text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_history_category"
        app:layout_constraintTop_toBottomOf="@id/tv_history_category" />

    <TextView
        android:id="@+id/tv_history_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dm_sans_regular"
        android:text="12 Oct 2023, 14:20"
        android:textColor="@color/brand_text_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/card_image"
        app:layout_constraintStart_toStartOf="@id/tv_history_category" />

    <View
        android:id="@+id/view_history_indicator"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/brand_neon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
