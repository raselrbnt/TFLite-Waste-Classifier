<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_bg_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Back Button & Header -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HASIL ANALISIS"
            android:textColor="@color/brand_dark_charcoal"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_back"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintHorizontal_bias="0.4" />

        <!-- Captured Image Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_image_container"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/black"
            app:layout_constraintTop_toBottomOf="@id/btn_back">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/img_captured"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Floating Chip: Inference Speed -->
                <TextView
                    android:id="@+id/tv_chip_inference_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 48 ms"
                    android:textColor="@color/brand_neon"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_margin="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Floating Chip: Offline Mode Indicator / Read-Only Indicator -->
                <TextView
                    android:id="@+id/tv_chip_offline_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 OFFLINE ML"
                    android:textColor="@color/brand_surface_white"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip_dark"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_margin="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Confidence Rating Horizontal Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_confidence"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            android:progress="98"
            android:max="100"
            android:progressDrawable="@drawable/bg_confidence_progress"
            app:layout_constraintTop_toBottomOf="@id/card_image_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Confidence Rating Text Label -->
        <TextView
            android:id="@+id/tv_lbl_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TINGKAT KEPERCAYAAN: 98.4%"
            android:textColor="@color/brand_text_secondary"
            android:fontFamily="@font/space_grotesk_medium"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/progress_confidence"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Classification Category Result -->
        <TextView
            android:id="@+id/tv_classification_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORGANIK"
            android:textColor="@color/brand_primary"
            android:fontFamily="@font/space_grotesk_bold"
            android:textSize="36sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_confidence"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Handling Instructions Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_minimal"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/tv_classification_result">

            <TextView
                android:id="@+id/lbl_instructions_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ⓘ INSTRUKSI PENANGANAN"
                android:textColor="@color/brand_dark_charcoal"
                android:fontFamily="@font/space_grotesk_bold"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/img_instructions_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron"
                app:tint="@color/brand_dark_charcoal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lbl_instructions_header"
                app:layout_constraintBottom_toBottomOf="@id/lbl_instructions_header" />

            <!-- Dynamic bullet instructions in vertical layout -->
            <LinearLayout
                android:id="@+id/layout_bullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/lbl_instructions_header">

                <!-- Bullet 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• "
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_bullet_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Buang ke dalam wadah atau tempat sampah khusus KOMPOS."
                        android:textColor="@color/brand_dark_charcoal"
                        android:fontFamily="@font/dm_sans_regular"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Bullet 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• "
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_bullet_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pastikan material bebas dari kontaminasi plastik pelapis atau stiker buah."
                        android:textColor="@color/brand_dark_charcoal"
                        android:fontFamily="@font/dm_sans_regular"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Bullet 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• "
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_bullet_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Material ini dapat terurai secara alami dan optimal untuk pembuatan pupuk organik."
                        android:textColor="@color/brand_dark_charcoal"
                        android:fontFamily="@font/dm_sans_regular"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2-Column Action Buttons Row -->
        <LinearLayout
            android:id="@+id/layout_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/card_instructions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_pindai_lainnya"
                style="@style/Widget.EcoTech.Button.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PINDAI LAINNYA"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_simpan_catatan"
                style="@style/Widget.EcoTech.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SIMPAN CATATAN"
                android:textSize="12sp"
                app:icon="@drawable/ic_total_scans"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                android:layout_marginStart="6dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
