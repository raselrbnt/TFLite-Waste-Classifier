<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Viewfinder Kamera (CameraX) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Pill: Sistem ML Aktif -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_ml_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/brand_surface_white"
        app:cardCornerRadius="4dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="((•)) [ SISTEM ML AKTIF ]"
            android:textColor="@color/brand_dark_charcoal"
            android:fontFamily="@font/space_grotesk_medium"
            android:textSize="11sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />
    </androidx.cardview.widget.CardView>

    <!-- Scanner Target Reticle (Retikel Viewfinder Tengah) -->
    <ImageView
        android:id="@+id/img_reticle"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/viewfinder_reticle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tulisan Mencari Objek di Bawah Retikel -->
    <TextView
        android:id="@+id/tv_searching_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ MENCARI OBJEK ]"
        android:textColor="@color/brand_neon"
        android:fontFamily="@font/space_grotesk_bold"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_reticle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Glassmorphic Bottom Control Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_panel"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tombol Galeri (Kiri) -->
        <ImageButton
            android:id="@+id/btn_gallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_gallery"
            android:background="@drawable/bg_card_minimal"
            android:scaleType="centerInside"
            app:tint="@color/brand_dark_charcoal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Tombol Capture (Tengah) -->
        <View
            android:id="@+id/btn_capture"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_capture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Tombol Flash (Kanan) -->
        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_flash"
            android:background="@drawable/bg_card_minimal"
            android:scaleType="centerInside"
            app:tint="@color/brand_dark_charcoal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Shutter Flash Overlay -->
    <View
        android:id="@+id/view_shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
