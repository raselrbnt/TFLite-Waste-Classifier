<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Viewfinder Kamera (CameraX) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Pill: SISTEM ML AKTIF -->
    <TextView
        android:id="@+id/tv_chip_ml_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SISTEM ML AKTIF"
        android:textColor="@color/brand_surface_white"
        android:fontFamily="@font/space_grotesk_bold"
        android:textSize="12sp"
        android:background="@drawable/bg_chip_dark"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scanner Target Reticle (Retikel Viewfinder Tengah) -->
    <ImageView
        android:id="@+id/img_reticle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:src="@drawable/viewfinder_reticle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tulisan [ MENCARI OBJEK ] di Bawah Retikel -->
    <TextView
        android:id="@+id/tv_searching_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ MENCARI OBJEK ]"
        android:textColor="@color/brand_surface_white"
        android:fontFamily="@font/space_grotesk_bold"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/img_reticle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Glassmorphic Bottom Control Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_panel"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tombol Galeri (Kiri) -->
        <ImageButton
            android:id="@+id/btn_gallery"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_gallery"
            android:background="@drawable/bg_circle_button"
            android:scaleType="centerInside"
            android:contentDescription="Buka Galeri"
            app:tint="@color/brand_surface_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Tombol Capture Dual-Ring (Tengah) -->
        <View
            android:id="@+id/btn_capture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_btn_capture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Tombol Flash (Kanan) -->
        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_flash"
            android:background="@drawable/bg_circle_button"
            android:scaleType="centerInside"
            android:contentDescription="Lampu Kilat"
            app:tint="@color/brand_surface_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Shutter Flash Overlay -->
    <View
        android:id="@+id/view_shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
