<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Neon Ring -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="@color/brand_neon" />
            <size android:width="72dp" android:height="72dp" />
        </shape>
    </item>
    <!-- Inner Solid Vibrant Green Button -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand_neon" />
        </shape>
    </item>
    <!-- Center Target Ring Dot -->
    <item android:top="26dp" android:left="26dp" android:right="26dp" android:bottom="26dp">
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="@color/brand_dark_charcoal" />
        </shape>
    </item>
</layer-list>
